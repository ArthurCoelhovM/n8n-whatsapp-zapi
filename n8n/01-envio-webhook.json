      "parameters": {
        "jsCode": "const TEMPLATE = 'Olá, {nome}! Tudo bem com você?';\n\nfunction normalizarTelefone(telefone) {\n  const digitos = String(telefone ?? '').replace(/\\D/g, '');\n  return /^55\\d{10,11}$/.test(digitos) ? digitos : null;\n}\n\nfunction mascararTelefone(telefone) {\n  const digitos = String(telefone ?? '').replace(/\\D/g, '');\n  if (digitos.length < 8) return '*'.repeat(digitos.length);\n  return digitos.slice(0, 4) + '*'.repeat(digitos.length - 8) + digitos.slice(-4);\n}\n\nfunction sanitizarNome(nome) {\n  if (!nome) return null;\n  let limpo = String(nome)\n    .replace(/[^A-Za-zÀ-ÖØ-öø-ÿ' -]/g, '')\n    .replace(/\\s+/g, ' ')\n    .replace(/^[ '-]+|[ '-]+$/g, '');\n  limpo = limpo.slice(0, 40).trim();\n  if (!limpo) return null;\n  return limpo.split(' ').map(p => p.charAt(0).toUpperCase() + p.slice(1).toLowerCase()).join(' ');\n}\n\nfunction montarMensagem(nome, template) {\n  if (nome) return template.split('{nome}').join(nome);\n  return template.replace(/,?\\s*\\{nome\\}/g, '');\n}\n\nconst corpo = $input.first().json.body || {};\nconst telefone = normalizarTelefone(corpo.telefone);\n\nif (!telefone) {\n  return [{ json: { valido: false, erro: 'Telefone inválido: use DDI 55 + DDD + número, só dígitos' } }];\n}\n\nconst template = typeof corpo.mensagem === 'string' && corpo.mensagem.trim()\n  ? corpo.mensagem.trim().slice(0, 1000)\n  : TEMPLATE;\nconst nome = sanitizarNome(corpo.nome);\n\nreturn [{\n  json: {\n    valido: true,\n    telefone,\n    telefoneMascarado: mascararTelefone(telefone),\n    nome,\n    mensagem: montarMensagem(nome, template)\n  }\n}];\n"
      },
