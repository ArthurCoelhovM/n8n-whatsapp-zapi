      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        200
      ]
    },
    {
      "parameters": {
        "operation": "getAll",
        "tableId": "contatos",
        "returnAll": false,
        "limit": "={{ Number($env.LIMITE_LOTE) || 3 }}",
        "filterType": "manual",
        "matchType": "allFilters",
        "filters": {
          "conditions": [
            {
              "keyName": "ativo",
              "condition": "eq",
              "keyValue": "true"
            }
          ]
        }
      },
      "id": "1fff6dbe-faaa-48fe-ae14-944f6a71c345",
      "name": "Buscar contatos ativos",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        240,
        100
      ]
    },
    {
      "parameters": {
        "batchSize": 1,
        "options": {}
      },
      "id": "de070f68-e46b-4f13-8e15-07f70fb9a68c",
      "name": "Um por vez",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        480,
        100
      ]
    },
    {
      "parameters": {
        "jsCode": "const TEMPLATE = 'Olá, {nome}! Tudo bem com você?';\n\nfunction normalizarTelefone(telefone) {\n  const digitos = String(telefone ?? '').replace(/\\D/g, '');\n  return /^55\\d{10,11}$/.test(digitos) ? digitos : null;\n}\n\nfunction mascararTelefone(telefone) {\n  const digitos = String(telefone ?? '').replace(/\\D/g, '');\n  if (digitos.length < 8) return '*'.repeat(digitos.length);\n  return digitos.slice(0, 4) + '*'.repeat(digitos.length - 8) + digitos.slice(-4);\n}\n\nfunction sanitizarNome(nome) {\n  if (!nome) return null;\n  let limpo = String(nome)\n    .replace(/[^A-Za-zÀ-ÖØ-öø-ÿ' -]/g, '')\n    .replace(/\\s+/g, ' ')\n    .replace(/^[ '-]+|[ '-]+$/g, '');\n  limpo = limpo.slice(0, 40).trim();\n  if (!limpo) return null;\n  return limpo.split(' ').map(p => p.charAt(0).toUpperCase() + p.slice(1).toLowerCase()).join(' ');\n}\n\nfunction montarMensagem(nome, template) {\n  if (nome) return template.split('{nome}').join(nome);\n  return template.replace(/,?\\s*\\{nome\\}/g, '');\n}\n\nreturn $input.all().map(item => {\n  const contato = item.json;\n  const telefone = normalizarTelefone(contato.telefone);\n  const nome = sanitizarNome(contato.nome);\n  return {\n    json: {\n      contatoId: contato.id,\n      telefone,\n      telefoneMascarado: mascararTelefone(contato.telefone),\n      mensagem: montarMensagem(nome, TEMPLATE)\n    }\n  };\n});\n"
      },
      "id": "cd812df7-d3a6-476a-a272-91cb6b64af9b",
      "name": "Montar mensagem",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        200
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://api.z-api.io/instances/{{ $env.ZAPI_INSTANCE_ID }}/token/{{ $env.ZAPI_TOKEN }}/send-text",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ phone: $json.telefone, message: $json.mensagem }) }}",
        "options": {
          "timeout": 15000
        }
      },
      "id": "e07601e4-8528-4c5f-a4b3-8c7969383811",
      "name": "Enviar pela Z-API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        960,
        200
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "operation": "create",
        "tableId": "envios",
        "dataToSend": "defineBelow",
        "fieldsUi": {
          "fieldValues": [
            {
              "fieldId": "contato_id",
              "fieldValue": "={{ $('Montar mensagem').item.json.contatoId }}"
            },
            {
              "fieldId": "telefone",
              "fieldValue": "={{ $('Montar mensagem').item.json.telefoneMascarado }}"
            },
            {
              "fieldId": "origem",
