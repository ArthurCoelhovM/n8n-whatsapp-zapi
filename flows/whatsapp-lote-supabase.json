{
  "name": "WhatsApp — Envio em Lote via Supabase",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 9 * * 1-5"
            }
          ]
        }
      },
      "id": "node-0001",
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 300],
      "notes": "Roda de segunda a sexta às 9h. Ajuste o cron conforme necessário."
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/contatos",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.SUPABASE_ANON_KEY }}"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.SUPABASE_ANON_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "notificado",
              "value": "eq.false"
            },
            {
              "name": "ativo",
              "value": "eq.true"
            },
            {
              "name": "select",
              "value": "id,nome,phone,mensagem_personalizada"
            }
          ]
        },
        "options": {}
      },
      "id": "node-0002",
      "name": "Buscar Contatos no Supabase",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [480, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond-lista-vazia",
              "leftValue": "={{ $json.length }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "node-0003",
      "name": "Tem Contatos?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [720, 300]
    },
    {
      "parameters": {
        "fieldToSplitOut": "={{ $json }}",
        "options": {}
      },
      "id": "node-0004",
      "name": "Separar em Itens",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [960, 200]
    },
    {
      "parameters": {
        "amount": 3,
        "unit": "seconds"
      },
      "id": "node-0005",
      "name": "Aguardar 3s",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [1200, 200],
      "notes": "Intervalo entre mensagens para evitar ban do WhatsApp."
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://api.z-api.io/instances/{{ $env.ZAPI_INSTANCE_ID }}/token/{{ $env.ZAPI_TOKEN }}/send-text",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Client-Token",
              "value": "={{ $env.ZAPI_CLIENT_TOKEN }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"phone\": \"{{ $json.phone }}\",\n  \"message\": \"{{ $json.mensagem_personalizada || 'Olá, ' + $json.nome + '! Temos uma novidade para você.' }}\"\n}",
        "options": {}
      },
      "id": "node-0006",
      "name": "Z-API Enviar Mensagem",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1440, 200]
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/contatos",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.SUPABASE_ANON_KEY }}"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.SUPABASE_ANON_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Prefer",
              "value": "return=minimal"
            }
          ]
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "id",
              "value": "=eq.{{ $('Separar em Itens').item.json.id }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"notificado\": true,\n  \"notificado_em\": \"{{ $now.toISO() }}\"\n}",
        "options": {}
      },
      "id": "node-0007",
      "name": "Marcar como Notificado",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1680, 200]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/log_envios",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.SUPABASE_ANON_KEY }}"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.SUPABASE_ANON_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Prefer",
              "value": "return=minimal"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"contato_id\": \"{{ $('Separar em Itens').item.json.id }}\",\n  \"phone\": \"{{ $('Separar em Itens').item.json.phone }}\",\n  \"status\": \"erro\",\n  \"erro_detalhes\": \"{{ $json.message }}\",\n  \"tentativa_em\": \"{{ $now.toISO() }}\"\n}",
        "options": {}
      },
      "id": "node-0008",
      "name": "Registrar Erro no Log",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1680, 360]
    },
    {
      "parameters": {
        "respondWith": "noData",
        "options": {}
      },
      "id": "node-0009",
      "name": "Nenhum Contato — Encerrar",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [960, 400]
    }
  ],
  "connections": {
    "Schedule Trigger": {
      "main": [
        [{ "node": "Buscar Contatos no Supabase", "type": "main", "index": 0 }]
      ]
    },
    "Buscar Contatos no Supabase": {
      "main": [
        [{ "node": "Tem Contatos?", "type": "main", "index": 0 }]
      ]
    },
    "Tem Contatos?": {
      "main": [
        [{ "node": "Separar em Itens", "type": "main", "index": 0 }],
        [{ "node": "Nenhum Contato — Encerrar", "type": "main", "index": 0 }]
      ]
    },
    "Separar em Itens": {
      "main": [
        [{ "node": "Aguardar 3s", "type": "main", "index": 0 }]
      ]
    },
    "Aguardar 3s": {
      "main": [
        [{ "node": "Z-API Enviar Mensagem", "type": "main", "index": 0 }]
      ]
    },
    "Z-API Enviar Mensagem": {
      "main": [
        [{ "node": "Marcar como Notificado", "type": "main", "index": 0 }]
      ],
      "error": [
        [{ "node": "Registrar Erro no Log", "type": "main", "index": 0 }]
      ]
    }
  },
  "pinData": {},
  "settings": {
    "executionOrder": "v1"
  },
  "staticData": null,
  "tags": ["whatsapp", "z-api", "supabase", "batch", "agendamento"],
  "triggerCount": 0,
  "updatedAt": "2025-07-01T00:00:00.000Z",
  "versionId": "v1"
}
